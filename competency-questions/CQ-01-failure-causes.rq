# CQ-01: Which causes are responsible for a given failure, and with what probability?
#
# This query retrieves the causal chain for a given failure, showing which other failures
# cause it and with what strength (weak, moderate, strong).

PREFIX mqto: <https://w3id.org/mqto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?causeFailure ?causeLabel ?causalStrength
WHERE {
  # Bind the target failure to investigate
  BIND(<https://w3id.org/mqto/example#Porosity> AS ?targetFailure)

  # Find failures that cause the target failure
  ?targetFailure mqto:causedBy ?causeFailure .
  ?causeFailure rdfs:label ?causeLabel .

  # Determine the causal strength
  OPTIONAL {
    ?targetFailure mqto:causedByWeakly ?causeFailure .
    BIND(1 AS ?weakRank)
  }
  OPTIONAL {
    ?targetFailure mqto:causedByModerately ?causeFailure .
    BIND(2 AS ?moderateRank)
  }
  OPTIONAL {
    ?targetFailure mqto:causedByStrongly ?causeFailure .
    BIND(3 AS ?strongRank)
  }

  # Select the strongest rank, defaulting to 0 when no strength is specified
  BIND(
    COALESCE(
      ?strongRank,
      ?moderateRank,
      ?weakRank,
      0
    ) AS ?strengthRank
  )
  BIND(
    IF(?strengthRank = 3, "strong",
      IF(?strengthRank = 2, "moderate",
        IF(?strengthRank = 1, "weak",
          "unspecified"
        )
      )
    ) AS ?causalStrength
  )
}
ORDER BY DESC(?strengthRank)
